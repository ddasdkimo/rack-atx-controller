(kicad_sch(version 20250114)(generator "eeschema")(uuid e26e9c9a-6137-5b0e-b3e3-ffc5633a6c0f)(paper "A3")(title_block(title "10-host rack ATX controller")(rev "B.2")(comment 1 "B.2 circuit - prototype review, not a manufacturing release"))(lib_symbols)(text "B.2: ten hosts, POWER / RESET only. Original case LEDs remain on motherboard.\n5 V input -> 3.3 V logic; ESP32-S3FN8 + W5500 -> 74HC595 -> twenty isolated dry contacts\nMC14541B counted timeout + independent ARM gate; no LED sensing or isolated DC/DC\nS.3 baseline / R.3 routing and package updates; factory DFM and prototype verification pending" (at 15 18 0)(effects(font(size 2 2))(justify left))(uuid 53b89c20-4b18-5737-8793-b33c5c569099))(sheet(at 15 52)(size 85 14)(stroke(width .254)(type default))(fill(color 0 0 0 0))(uuid 2e0c5b80-f227-541c-aafd-d405dcb24d5a)(property "Sheetname" "5 V input, protection and 3.3 V buck"(at 15 50 0)(effects(font(size 1 1))(justify left)))(property "Sheetfile" "power.kicad_sch"(at 15 68 0)(effects(font(size 1 1))(justify left)))(instances(project "rack-atx-controller"(path "/e26e9c9a-6137-5b0e-b3e3-ffc5633a6c0f"(page "2")))))(sheet(at 115 52)(size 85 14)(stroke(width .254)(type default))(fill(color 0 0 0 0))(uuid 9b65307c-93d4-5b24-8af6-c081e3e79102)(property "Sheetname" "ESP32-S3FN8 / USB programming (1/2)"(at 115 50 0)(effects(font(size 1 1))(justify left)))(property "Sheetfile" "processor_1.kicad_sch"(at 115 68 0)(effects(font(size 1 1))(justify left)))(instances(project "rack-atx-controller"(path "/e26e9c9a-6137-5b0e-b3e3-ffc5633a6c0f"(page "3")))))(sheet(at 215 52)(size 85 14)(stroke(width .254)(type default))(fill(color 0 0 0 0))(uuid 7fc18e26-b1a1-5315-86dd-f4921f8d7f7f)(property "Sheetname" "ESP32-S3FN8 / USB programming (2/2)"(at 215 50 0)(effects(font(size 1 1))(justify left)))(property "Sheetfile" "processor_2.kicad_sch"(at 215 68 0)(effects(font(size 1 1))(justify left)))(instances(project "rack-atx-controller"(path "/e26e9c9a-6137-5b0e-b3e3-ffc5633a6c0f"(page "4")))