(version 1)
# Low-voltage functional isolation; not a safety isolation rating.
(rule "H01 independent domain" (condition "(A.NetName == 'H01_*' && A.NetName != 'H01_PLED_N' && A.NetName != 'H01_HDD_N') && B.NetName != '' && !(B.NetName == 'H01_*' && B.NetName != 'H01_PLED_N' && B.NetName != 'H01_HDD_N')") (constraint clearance (min 1mm)))
